LocalPort=5001
mongoURL=mongodb://localhost:27017/ecms
mongoURLProduction=

FrontEndHost=http://localhost:3000
BackEndHost=http://localhost:5001

FrontEndHostProduction=

jwtSecret=

# Creates the first admin on startup if none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public demo: sample data, one-click role logins, nightly reset at 03:00 UTC.
# Never turn this on for a database with real care records.
DEMO_MODE=false
DEMO_PASSWORD=ecms-demo

# Optional tuning
LOGIN_RATE_LIMIT=20
ROTA_PER_DAY=5
